ets_log_user_id_to_null(tmp_path, monkeypatch):\\n    \\\"\\\"\\\"Deleting a user sets user_id to NULL in audit_log and api_usage (ON DELETE SET NULL).\\\"\\\"\\\"\\n    import backend.database as db_mod\\n\\n    db_path = str(tmp_path / \\\"capstone.db\\\")\\n    monkeypatch.setattr(db_mod, \\\"DB_PATH\\\", db_path)\\n    db_mod.init_db()\\n\\n    conn = db_mod.get_connection()\\n    try:\\n        uid = _setup_user_and_logs(conn)\\n        conn.execute(\\\"DELETE FROM users WHERE id = ?\\\", (uid,))\\n        conn.commit()\\n\\n        audit_uid = conn.execute(\\\"SELECT user_id FROM audit_log\\\").fetchone()[0]\\n        usage_uid = conn.execute(\\\"SELECT user_id FROM api_usage\\\").fetchone()[0]\\n        assert audit_uid is None, f\\\"Expected NULL in audit_log.user_id, got {audit_uid}\\\"\\n        assert usage_uid is None, f\\\"Expected NULL in api_usage.user_id, got {usage_uid}\\\"\\n    finally:\\n        conn.close()\"}","id":"tooluse_QUMtKo9Zi4qP68ewVVjFiS","name":"strReplace","index":1}],"tool_calls":[{"name":"strReplace","args":{"path":"backend/tests/test_database.py","oldStr":"def test_delete_user_blocked_when_logs_exist(tmp_path, monkeypatch):\n    \"\"\"Deleting a user with FK enforcement on is blocked while referencing log rows exist.\"\"\"\n    import backend.database as db_mod\n\n    db_path = str(tmp_path / \"capstone.db\")\n    monkeypatch.setattr(db_mod, \"DB_PATH\", db_path)\n    db_mod.init_db()\n\n    conn = db_mod.get_connection()  # FK enforcement is ON via get_connection()\n    try:\n        uid = _setup_user_and_logs(conn)\n        with pytest.raises(sqlite3.IntegrityError):\n            conn.execute(\"DELETE FROM users WHERE id = ?\", (uid,))\n            conn.commit()\n    finally:\n        conn.close()\n\n\ndef test_delete_user_succeeds_after_clearing_logs(tmp_path, monkeypatch):\n    \"\"\"Deleting a user succeeds once all referencing log rows are removed first.\"\"\"\n    import backend.database as db_mod\n\n    db_path = str(tmp_path / \"capstone.db\")\n    monkeypatch.setattr(db_mod, \"DB_PATH\", db_path)\n    db_mod.init_db()\n\n    conn = db_mod.get_connection()\n    try:\n        uid = _setup_user_and_logs(conn)\n        conn.execute(\"DELETE FROM audit_log WHERE user_id = ?\", (uid,))\n        conn.execute(\"DELETE FROM api_usage WHERE user_id = ?\", (uid,))\n        conn.commit()\n        conn.execute(\"DELETE FROM users WHERE id = ?\", (uid,))\n        conn.commit()\n        count = conn.execute(\"SELECT COUNT(*) FROM users WHERE id = ?\", (uid,)).fetchone()[0]\n        assert count == 0\n    finally:\n        conn.close()","newStr":"def test_delete_user_sets_log_user_id_to_null(tmp_path, monkeypatch):\n    \"\"\"Deleting a user sets user_id to NULL in audit_log and api_usage (ON DELETE SET NULL).\"\"\"\n    import backend.database as db_mod\n\n    db_path = str(tmp_path / \"capstone.db\")\n    monkeypatch.setattr(db_mod, \"DB_PATH\", db_path)\n    db_mod.init_db()\n\n    conn = db_mod.get_connection()\n    try:\n        uid = _setup_user_and_logs(conn)\n        conn.execute(\"DELETE FROM users WHERE id = ?\", (uid,))\n        conn.commit()\n\n        audit_uid = conn.execute(\"SELECT user_id FROM audit_log\").fetchone()[0]\n        usage_uid = conn.execute(\"SELECT user_id FROM api_usage\").fetchone()[0]\n        assert audit_uid is None, f\"Expected NULL in audit_log.user_id, got {audit_uid}\"\n        assert usage_uid is None, f\"Expected NULL in api_usage.user_id, got {usage_uid}\"\n    finally:\n        conn.close()"},"id":"tooluse_QUMtKo9Zi4qP68ewVVjFiS","type":"tool_call"}],"invalid_tool_calls":[]}}}}}
