---------------------------------------------------\\n# Password hashing — users table stores bcrypt hashes, never plaintext\\n# ---------------------------------------------------------------------------\\n\\ndef test_seeded_passwords_are_bcrypt_hashed(tmp_path, monkeypatch):\\n    \\\"\\\"\\\"Passwords stored in users.password_hash are bcrypt hashes, not plaintext.\\\"\\\"\\\"\\n    import bcrypt\\n    import backend.database as db_mod\\n    from backend.seed import seed_users, USERS\\n\\n    db_path = str(tmp_path / \\\"capstone.db\\\")\\n    monkeypatch.setattr(db_mod, \\\"DB_PATH\\\", db_path)\\n    db_mod.init_db()\\n\\n    conn = db_mod.get_connection()\\n    try:\\n        seed_users(conn)\\n        conn.commit()\\n        rows = conn.execute(\\\"SELECT username, password_hash FROM users\\\").fetchall()\\n    finally:\\n        conn.close()\\n\\n    assert len(rows) == len(USERS), \\\"Expected one row per seeded user\\\"\\n\\n    plain_by_username = {u[\\\"username\\\"]: u[\\\"password\\\"] for u in USERS}\\n    for row in rows:\\n        stored = row[\\\"password_hash\\\"]\\n        plain = plain_by_username[row[\\\"username\\\"]]\\n\\n        # Must not store plaintext\\n        assert stored != plain, f\\\"Password for {row['username']} is stored as plaintext\\\"\\n\\n        # Must be a valid bcrypt hash that verifies against the original password\\n        assert bcrypt.checkpw(plain.encode(), stored.encode()), \\\\\\n            f\\\"Stored hash for {row['username']} does not verify against the original password\\\"\\n\"}","id":"tooluse_K6ZPZvnFPtlBHx6xLHSFEI","name":"fsAppend","index":1}],"tool_calls":[{"name":"fsAppend","args":{"path":"backend/tests/test_database.py","text":"\n\n# ---------------------------------------------------------------------------\n# Password hashing — users table stores bcrypt hashes, never plaintext\n# ---------------------------------------------------------------------------\n\ndef test_seeded_passwords_are_bcrypt_hashed(tmp_path, monkeypatch):\n    \"\"\"Passwords stored in users.password_hash are bcrypt hashes, not plaintext.\"\"\"\n    import bcrypt\n    import backend.database as db_mod\n    from backend.seed import seed_users, USERS\n\n    db_path = str(tmp_path / \"capstone.db\")\n    monkeypatch.setattr(db_mod, \"DB_PATH\", db_path)\n    db_mod.init_db()\n\n    conn = db_mod.get_connection()\n    try:\n        seed_users(conn)\n        conn.commit()\n        rows = conn.execute(\"SELECT username, password_hash FROM users\").fetchall()\n    finally:\n        conn.close()\n\n    assert len(rows) == len(USERS), \"Expected one row per seeded user\"\n\n    plain_by_username = {u[\"username\"]: u[\"password\"] for u in USERS}\n    for row in rows:\n        stored = row[\"password_hash\"]\n        plain = plain_by_username[row[\"username\"]]\n\n        # Must not store plaintext\n        assert stored != plain, f\"Password for {row['username']} is stored as plaintext\"\n\n        # Must be a valid bcrypt hash that verifies against the original password\n        assert bcrypt.checkpw(plain.encode(), stored.encode()), \\\n            f\"Stored hash for {row['username']} does not verify against the original password\"\n"},"id":"tooluse_K6ZPZvnFPtlBHx6xLHSFEI","type":"tool_call"}],"invalid_tool_calls":[]}}}}}
