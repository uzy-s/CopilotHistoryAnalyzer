9njz","name":"readFile","input":{"path":"backend/tests/test_database_properties.py","explanation":"See what property tests already exist"}}]}},{"userInputMessage":{"content":"","modelId":"auto","origin":"AI_EDITOR","userInputMessageContext":{"toolResults":[{"toolUseId":"tooluse_7HvlnmybzzE7PBzXif9njz","content":[{"text":"<file name=\"backend/tests/test_database_properties.py\" language=\"python\" >\n<content>\n\"\"\"Property-based tests for backend.database using Hypothesis.\r\n\r\nFeature: database-initialization\r\n\"\"\"\r\nimport sqlite3\r\nimport pytest\r\nfrom hypothesis import given, settings, HealthCheck\r\nfrom hypothesis import strategies as st\r\n\r\nimport backend.database as db_module\r\nfrom backend.database import get_connection, init_db\r\n\r\nEXPECTED_TABLES = {\"users\", \"audit_log\", \"api_usage\", \"idms_data\"}\r\n\r\n\r\ndef _get_tables(db_path: str) -> set:\r\n    conn = sqlite3.connect(db_path)\r\n    try:\r\n        rows = conn.execute(\r\n            \"SELECT name FROM sqlite_master WHERE type='table'\"\r\n        ).fetchall()\r\n        return {row[0] for row in rows}\r\n    finally:\r\n        conn.close()\r\n\r\n\r\n# ---------------------------------------------------------------------------\r\n# Property 1: init_db() always produces all four tables\r\n# Feature: database-initialization, Property 1: init_db() always produces all four tables\r\n# Validates: Requirements 1.1, 1.2, 1.3\r\n# ---------------------------------------------------------------------------\r\n\r\n@given(call_count=st.integers(min_value=1, max_value=5))\r\n@settings(max_examples=100, suppress_health_check=[HealthCheck.function_scoped_fixture])\r\ndef test_init_db_idempotent(tmp_path, call_count, monkeypatch):\r\n    \"\"\"Property 1: Calling init_db() 1–5 times always results in all four tables existing.\r\n\r\n    Validates: Requirements 1.1, 1.2, 1.3\r\n    \"\"\"\r\n    db_path = str(tmp_path / \"test.db\")\r\n    monkeypatch.setattr(db_module, \"DB_PATH\", db_path)\r\n\r\n    for _ in range(call_count):\r\n        init_db()\r\n        tables = _get_tables(db_path)\r\n        assert EXPECTED_TABLES.issubset(tables), (\r\n            f\"After a call to init_db(), expected tables {EXPECTED_TABLES} \"\r\n            f\"but found {tables}\"\r\n        )\r\n\r\n\r\n# ---------------------------------------------------------------------------\r\n# Property 2: Every connection is correctly configured\r\n# Feature: database-initialization, Property 2: Every connection is correctly configured\r\n# Validates: Requirements 3.1, 3.2\r\n# ---------------------------------------------------------------------------\r\n\r\n@given(unused=st.just(None))\r\n@settings(max_examples=100, suppress_health_check=[HealthCheck.function_scoped_fixture])\r\ndef test_connection_configured(tmp_path, monkeypatch, unused):\r\n    \"\"\"Property 2: get_connection() always returns a connection with row_factory=sqlite3.Row\r\n    and PRAGMA foreign_keys = 1.\r\n\r\n    Validates: Requirements 3.1, 3.2\r\n    \"\"\"\r\n    db_path = str(tmp_path / \"test.db\")\r\n    monkeypatch.setattr(db_module, \"DB_PATH\", db_path)\r\n\r\n    conn = get_connection()\r\n    try:\r\n        assert conn.row_factory is sqlite3.Row, (\r\n            \"Connection row_factory must be sqlite3.Row\"\r\n        )\r\n        fk = conn.execute(\"PRAGMA foreign_keys\").fetchone()[0]\r\n        assert fk == 1, (\r\n            f\"PRAGMA foreign_keys must be 1 (enabled), got {fk}\"\r\n        )\r\n    finally:\r\n        conn.close()\r\n\r\nimport re\r\nimport backend.database as db_module\r\nfrom backend.seed import seed_idms\r\n\r\nVALID_STATUSES = {\"Active\", \"Inactive\", \"Under Maintenance\", \"Decommissioned\"}\r\nVALID_CATEGORIES = {\"Mixing\", \"Building\", \"Curing\", \"Inspection\", \"Material Handling\"}\r\nIDMS_PATTERN = re.compile(r\"^IDMS-\\d{4}$\")\r\nEXPECTED_IDMS_COLUMNS = {\r\n    \"id\", \"record_id\", \"equipment_name\", \"equipment_type\",\r\n    \"plant_location\", \"status\", \"category\", \"last_maintenance_date\", \"updated_at\"\r\n}\r\n\r\n\r\n# ---------------------------------------------------------------------------\r\n# Property 3: idms_data table has the required schema\r\n# Feature: database-initialization, Property 3: idms_data table has the required schema\r\n# Validates: Requirements 4.1\r\n# ---------------------------------------------------------------------------\r\n\r\n@given(unused=st.just(None))\r\n@settings(max_examples=100, suppress_health_check=[HealthCheck.function_scoped_fixture])\r\ndef test_idms_schema_columns(tmp_path, monkeypatch, unused):\r\n    \"\"\"Property 3: After init_db(), idms_data has exactly the required 9 columns.\"\"\"\r\n    db_path = str(tmp_path / \"test.db\")\r\n    monkeypatch.setattr(db_module, \"DB_PATH\", db_path)\r\n\r\n    init_db()\r\n    conn = get_connection()\r\n    try:\r\n        cols = {row[1] for row in conn.execute(\"PRAGMA table_info(idms_data)\")}\r\n    finally:\r\n        conn.close()\r\n\r\n    assert cols == EXPECTED_IDMS_COLUMNS, (\r\n        f\"Expected columns {EXPECTED_IDMS_COLUMNS}, got {cols}\"\r\n    )\r\n\r\n\r\n# ---------------------------------------------------------------------------\r\n# Property 4: Seeded status and category values are within allowed sets\r\n# Feature: database-initialization, Property 4: Seeded status and category values are within allowed sets\r\n# Validates: Requirements 4.4, 4.5\r\n# ---------------------------------------------------------------------------\r\n\r\n@given(unused=st.just(None))\r\n@settings(max_examples=100, suppress_health_check=[HealthCheck.function_scoped_fixture])\r\ndef test_seed_values_valid(tmp_path, monkeypatch, unused):\r\n    \"\"\"Property 4: Every seeded row has status and category within allowed sets.\"\"\"\r\n    db_path = str(tmp_path / \"test.db\")\r\n    monkeypatch.setattr(db_module, \"DB_PATH\", db_path)\r\n\r\n    init_db()\r\n    conn = get_connection()\r\n    try:\r\n        seed_idms(conn)\r\n        conn.commit()\r\n        rows = conn.execute(\"SELECT status, category FROM idms_data\").fetchall()\r\n    finally:\r\n        conn.close()\r\n\r\n    assert len(rows) > 0, \"Expected at least one seeded row\"\r\n    for row in rows:\r\n        assert row[\"status\"] in VALID_STATUSES, f\"Invalid status: {row['status']}\"\r\n        assert row[\"category\"] in VALID_CATEGORIES, f\"Invalid category: {row['category']}\"\r\n\r\n\r\n# ---------------------------------------------------------------------------\r\n# Property 5: Seed record IDs follow the IDMS-XXXX format\r\n# Feature: database-initialization, Property 5: Seed record IDs follow the IDMS-XXXX format\r\n# Validates: Requirements 5.2\r\n# ---------------------------------------------------------------------------\r\n\r\n@given(unused=st.just(None))\r\n@settings(max_examples=100, suppress_health_check=[HealthCheck.function_scoped_fixture])\r\ndef test_seed_record_id_format(tmp_path, monkeypatch, unused):\r\n    \"\"\"Property 5: Every seeded record_id matches IDMS-XXXX format.\"\"\"\r\n    db_path = str(tmp_path / \"test.db\")\r\n    monkeypatch.setattr(db_module, \"DB_PATH\", db_path)\r\n\r\n    init_db()\r\n    conn = get_connection()\r\n    try:\r\n        seed_idms(conn)\r\n        conn.commit()\r\n        rows = conn.execute(\"SELECT record_id FROM idms_data\").fetchall()\r\n    finally:\r\n        conn.close()\r\n\r\n    assert len(rows) > 0, \"Expected at least one seeded row\"\r\n    for row in rows:\r\n        assert IDMS_PATTERN.match(row[\"record_id\"]), (\r\n            f\"record_id '{row['record_id']}' does not match IDMS-XXXX format\"\r\n        )\r\n\r\n\r\n# ---------------------------------------------------------------------------\r\n# Property 6: Seed loader is idempotent\r\n# Feature: database-initialization, Property 6: Seed loader is idempotent\r\n# Validates: Requirements 5.6\r\n# ---------------------------------------------------------------------------\r\n\r\n@given(extra_calls=st.integers(min_value=1, max_value=4))\r\n@settings(max_examples=100, suppress_health_check=[HealthCheck.function_scoped_fixture])\r\ndef test_seed_idempotent(tmp_path, monkeypatch, extra_calls):\r\n    \"\"\"Property 6: Calling seed_idms() multiple times does not change the row count.\"\"\"\r\n    db_path = str(tmp_path / \"test.db\")\r\n    monkeypatch.setattr(db_module, \"DB_PATH\", db_path)\r\n\r\n    init_db()\r\n    conn = get_connection()\r\n    try:\r\n        seed_idms(conn)\r\n        conn.commit()\r\n        count_after_first = conn.execute(\"SELECT COUNT(*) FROM idms_data\").fetchone()[0]\r\n\r\n        for _ in range(extra_calls):\r\n            seed_idms(conn)\r\n            conn.commit()\r\n\r\n        count_final = conn.execute(\"SELECT COUNT(*) FROM idms_data\").fetchone()[0]\r\n    finally:\r\n        conn.close()\r\n\r\n    assert count_final == count_after_first, (\r\n        f\"Row count changed after repeated seeding: {count_after_first} → {count_final}\"\r\n    )\r\n\r\n\r\n# ---------------------------------------------------------------------------\r\n# Property 7: Dashboard response fields satisfy the frontend contract\r\n# Feature: database-initialization, Property 7: Dashboard response fields satisfy the frontend contract\r\n# Validates: Requirements 6.4\r\n# ---------------------------------------------------------------------------\r\n\r\n@given(unused=st.just(None))\r\n@settings(max_examples=20, suppress_health_check=[HealthCheck.function_scoped_fixture], deadline=None)\r\ndef test_dashboard_response_fields(tmp_path, monkeypatch, unused):\r\n    \"\"\"Property 7: GET /api/dashboard/idms returns records with required frontend fields.\"\"\"\r\n    from fastapi.testclient import TestClient\r\n    import backend.database as db_mod\r\n    from backend.main import app\r\n\r\n    db_path = str(tmp_path / \"test.db\")\r\n    monkeypatch.setattr(db_mod, \"DB_PATH\", db_path)\r\n\r\n    # Trigger lifespan (calls init_db()) then seed\r\n    with TestClient(app) as client:\r\n        conn = db_mod.get_connection()\r\n        try:\r\n            seed_idms(conn)\r\n            conn.commit()\r\n        finally:\r\n            conn.close()\r\n\r\n        response = client.get(\"/api/dashboard/idms\")\r\n\r\n    assert response.status_code == 200\r\n    body = response.json()\r\n    assert body[\"status\"] == \"success\"\r\n    assert isinstance(body[\"data\"], list)\r\n    assert len(body[\"data\"]) > 0, \"Expected seeded data in response\"\r\n    for record in body[\"data\"]:\r\n        assert \"record_id\" in record, f\"Missing record_id in {record}\"\r\n        assert \"description\" in record, f\"Missing description in {record}\"\r\n        assert \"status\" in record, f\"Missing status in {record}\"\r\n        assert \"category\" in record, f\"Missing category in {record}\"\r\n        assert \"updated_at\" in record, f\"Missing updated_at in {record}\"\r\n\r\n\r\n# ---------------------------------------------------------------------------\r\n# Property 8: api_usage table has the required schema including nullable user_id\r\n# Feature: database-initialization, Property 8: api_usage table has the required schema including nullable user_id\r\n# Validates: Requirements 7.1, 7.2\r\n# ---------------------------------------------------------------------------\r\n\r\n@given(unused=st.just(None))\r\n@settings(max_examples=100, suppress_health_check=[HealthCheck.function_scoped_fixture])\r\ndef test_api_usage_schema(tmp_path, monkeypatch, unused):\r\n    \"\"\"Property 8: api_usage table has the required schema including nullable user_id.\r\n\r\n    Validates: Requirements 7.1, 7.2\r\n    \"\"\"\r\n    db_path = str(tmp_path / \"test.db\")\r\n    monkeypatch.setattr(db_module, \"DB_PATH\", db_path)\r\n    init_db()\r\n    conn = get_connection()\r\n    try:\r\n        cols = {row[1]: row for row in conn.execute(\"PRAGMA table_info(api_usage)\")}\r\n    finally:\r\n        conn.close()\r\n    assert set(cols.keys()) == {\"id\", \"endpoint\", \"page\", \"timestamp\", \"user_id\"}\r\n    # user_id must be nullable (notnull == 0); PRAGMA table_info columns: cid, name, type, notnull, dflt_value, pk\r\n    assert cols[\"user_id\"][3] == 0, \"user_id must be nullable (notnull=0)\"\r\n\r\n\r\n# ---------------------------------------------------------------------------\r\n# Property 9: user_id is stored and retrieved correctly for both authenticated and unauthenticated records\r\n# Feature: database-initialization, Property 9: user_id is stored and retrieved correctly\r\n# Validates: Requirements 7.4, 7.5\r\n# ---------------------------------------------------------------------------\r\n\r\n@given(uid=st.one_of(st.none(), st.integers(min_value=1, max_value=100)))\r\n@settings(max_examples=100, suppress_health_check=[HealthCheck.function_scoped_fixture])\r\ndef test_user_id_round_trip(tmp_path, monkeypatch, uid):\r\n    \"\"\"Property 9: user_id is stored and retrieved correctly for both NULL and non-NULL.\r\n\r\n    Validates: Requirements 7.4, 7.5\r\n    \"\"\"\r\n    import uuid\r\n    db_path = str(tmp_path / \"test.db\")\r\n    monkeypatch.setattr(db_module, \"DB_PATH\", db_path)\r\n    init_db()\r\n    conn = get_connection()\r\n    try:\r\n        # When uid is non-NULL, insert a user with that exact id to satisfy the FK constraint.\r\n        # Use INSERT OR IGNORE to handle the case where the user already exists from a prior example.\r\n        if uid is not None:\r\n            conn.execute(\r\n                \"INSERT OR IGNORE INTO users (id, name, username, password_hash, email) VALUES (?, ?, ?, ?, ?)\",\r\n                (uid, \"Test User\", f\"testuser{uid}\", \"hash\", f\"test{uid}@example.com\"),\r\n            )\r\n            conn.commit()\r\n        # Use a unique endpoint per example to avoid row collisions across Hypothesis examples\r\n        unique_endpoint = f\"/api/test/{uuid.uuid4().hex}\"\r\n        conn.execute(\r\n            \"INSERT INTO api_usage (endpoint, page, timestamp, user_id) VALUES (?, ?, ?, ?)\",\r\n            (unique_endpoint, \"test\", \"2025-01-01T00:00:00Z\", uid),\r\n        )\r\n        conn.commit()\r\n        row = conn.execute(\r\n            \"SELECT user_id FROM api_usage WHERE endpoint = ?\", (unique_endpoint,)\r\n        ).fetchone()\r\n        assert row[\"user_id\"] == uid\r\n    finally:\r\n        conn.close()\r\n\r\n\r\n# ---------------------------------------------------------------------------\r\n# Property 10: Seeded usage records cover all users and span at least 35 days\r\n# Feature: database-initialization, Property 10: Seeded usage records cover all users and span at least 35 days\r\n# Validates: Requirements 8.1, 8.2, 8.3\r\n# ---------------------------------------------------------------------------\r\n\r\n@given(unused=st.just(None))\r\n@settings(max_examples=20, suppress_health_check=[HealthCheck.function_scoped_fixture], deadline=None)\r\ndef test_seed_api_usage_coverage(tmp_path, monkeypatch, unused):\r\n    \"\"\"Property 10: Seeded usage records cover all users and span at least 35 days.\r\n\r\n    Validates: Requirements 8.1, 8.2, 8.3\r\n    \"\"\"\r\n    from backend.seed import seed_users, seed_api_usage\r\n    from datetime import datetime\r\n    db_path = str(tmp_path / \"test.db\")\r\n    monkeypatch.setattr(db_module, \"DB_PATH\", db_path)\r\n    init_db()\r\n    conn = get_connection()\r\n    try:\r\n        seed_users(conn)\r\n        conn.commit()\r\n        seed_api_usage(conn)\r\n        conn.commit()\r\n        user_ids_in_users = {r[0] for r in conn.execute(\"SELECT id FROM users\")}\r\n        user_ids_in_usage = {r[0] for r in conn.execute(\"SELECT DISTINCT user_id FROM api_usage WHERE user_id IS NOT NULL\")}\r\n        assert user_ids_in_users <= user_ids_in_usage, \"Every user must appear in at least one usage record\"\r\n        timestamps = [r[0] for r in conn.execute(\"SELECT timestamp FROM api_usage ORDER BY timestamp\")]\r\n        earliest = datetime.fromisoformat(timestamps[0].replace(\"Z\", \"+00:00\"))\r\n        latest = datetime.fromisoformat(timestamps[-1].replace(\"Z\", \"+00:00\"))\r\n        assert (latest - earliest).days >= 34, f\"Timestamps span only {(latest - earliest).days} days, need >= 34\"\r\n    finally:\r\n        conn.close()\r\n\r\n\r\n# ---------------------------------------------------------------------------\r\n# Property 11: Date range query returns correct total and breakdown\r\n# Feature: database-initialization, Property 11: Date range query returns correct total and breakdown\r\n# Validates: Requirements 9.2, 9.3, 9.5\r\n# ---------------------------------------------------------------------------\r\n\r\nfrom datetime import date, timedelta\r\n\r\n@given(\r\n    start=st.dates(min_value=date(2025, 1, 1), max_value=date(2025, 3, 1)),\r\n    delta=st.integers(min_value=0, max_value=60),\r\n)\r\n@settings(max_examples=50, suppress_health_check=[HealthCheck.function_scoped_fixture], deadline=None)\r\ndef test_usage_query_total_and_breakdown(tmp_path, monkeypatch, start, delta):\r\n    \"\"\"Property 11: Date range query returns correct total and breakdown matching DB ground truth.\r\n\r\n    Validates: Requirements 9.2, 9.3, 9.5\r\n    \"\"\"\r\n    from fastapi.testclient import TestClient\r\n    from backend.seed import seed_users, seed_api_usage\r\n    import backend.database as db_mod\r\n    from backend.main import app\r\n\r\n    end = start + timedelta(days=delta)\r\n    start_ts = f\"{start}T00:00:00Z\"\r\n    end_ts = f\"{end}T23:59:59Z\"\r\n\r\n    db_path = str(tmp_path / \"test.db\")\r\n    monkeypatch.setattr(db_mod, \"DB_PATH\", db_path)\r\n\r\n    with TestClient(app) as client:\r\n        conn = db_mod.get_connection()\r\n        try:\r\n            seed_users(conn)\r\n            conn.commit()\r\n            seed_api_usage(conn)\r\n            conn.commit()\r\n            rows = conn.execute(\r\n                \"SELECT page, COUNT(*) as cnt FROM api_usage \"\r\n                \"WHERE timestamp >= ? AND timestamp <= ? GROUP BY page\",\r\n                (start_ts, end_ts),\r\n            ).fetchall()\r\n            expected_breakdown = {r[\"page\"]: r[\"cnt\"] for r in rows}\r\n            expected_total = sum(expected_breakdown.values())\r\n        finally:\r\n            conn.close()\r\n\r\n        response = client.get(f\"/api/dashboard/usage?start={start}&end={end}\")\r\n\r\n    assert response.status_code == 200\r\n    body = response.json()\r\n    assert body[\"total\"] == expected_total\r\n    assert body[\"breakdown\"] == expected_breakdown\r\n\r\n\r\n# ---------------------------------------------------------------------------\r\n# Property 12: Date range query returns HTTP 422 when start is after end\r\n# Feature: database-initialization, Property 12: Date range query returns HTTP 422 when start is after end\r\n# Validates: Requirements 9.4\r\n# ---------------------------------------------------------------------------\r\n\r\n@given(\r\n    end=st.dates(min_value=date(2025, 1, 1), max_value=date(2025, 12, 31)),\r\n    delta=st.integers(min_value=1, max_value=365),\r\n)\r\n@settings(max_examples=100, suppress_health_check=[HealthCheck.function_scoped_fixture], deadline=None)\r\ndef test_usage_query_invalid_range(tmp_path, monkeypatch, end, delta):\r\n    \"\"\"Property 12: start > end always returns HTTP 422.\r\n\r\n    Validates: Requirements 9.4\r\n    \"\"\"\r\n    from fastapi.testclient import TestClient\r\n    import backend.database as db_mod\r\n    from backend.main import app\r\n\r\n    start = end + timedelta(days=delta)  # start is always after end\r\n\r\n    db_path = str(tmp_path / \"test.db\")\r\n    monkeypatch.setattr(db_mod, \"DB_PATH\", db_path)\r\n\r\n    with TestClient(app) as client:\r\n        response = client.get(f\"/api/dashboard/usage?start={start}&end={end}\")\r\n\r\n    assert response.status_code == 422\r\n\n</content>\n</file>"}],"status":"success"}]}}},{"assistantResp