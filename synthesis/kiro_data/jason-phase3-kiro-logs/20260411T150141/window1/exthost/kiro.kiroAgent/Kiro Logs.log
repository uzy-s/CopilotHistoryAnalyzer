2026-04-11 17:26:16.367 [info] [Terminal] Executing command {"terminalId":1,"command":"python -c \"\nimport sqlite3, sys\nsys.path.insert(0, '.')\nfrom backend.database import init_db, get_connection\nfrom backend.seed import seed_users, seed_api_usage\nimport tempfile, os\n\n# Patch DB_PATH to a temp file\nimport backend.database as db_mod\ntmp = tempfile.mktemp(suffix='.db')\ndb_mod.DB_PATH = tmp\n\ninit_db()\nconn = get_connection()\nseed_users(conn)\nseed_api_usage(conn)\nconn.commit()\n\n# Verify idempotence guard\nseed_api_usage(conn)  # should skip\n\n# Verify user_id is populated\nrows = conn.execute('SELECT DISTINCT user_id FROM api_usage WHERE user_id IS NOT NULL').fetchall()\nprint('Distinct user_ids in api_usage:', [r[0] for r in rows])\n\n# Verify all users covered\nuser_ids = {r[0] for r in conn.execute('SELECT id FROM users').fetchall()}\nusage_user_ids = {r[0] for r in conn.execute('SELECT DISTINCT user_id FROM api_usage WHERE user_id IS NOT NULL').fetchall()}\nprint('All users covered:', user_ids <= usage_user_ids)\n\n# Verify 35-day span\nfrom datetime import datetime\ntimestamps = [r[0] for r in conn.execute('SELECT timestamp FROM api_usage ORDER BY timestamp').fetchall()]\nearliest = datetime.fromisoformat(timestamps[0].replace('Z', '+00:00'))\nlatest = datetime.fromisoformat(timestamps[-1].replace('Z', '+00:00'))\nprint('Day span:', (latest - earliest).days, '>= 34:', (latest - earliest).days >= 34)\n\n# Verify total count\ntotal = conn.execute('SELECT COUNT(*) FROM api_usage').fetchone()[0]\nprint('Total rows:', total)\n\nconn.close()\nos.unlink(tmp)\nprint('All checks passed.')\n\" 2>&1"}
